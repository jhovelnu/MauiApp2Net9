<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiApp2Net9.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    HideSoftInputOnTapped="True">

    <Grid
        Padding="10"
        ColumnDefinitions="*,*"
        RowDefinitions="Auto,*">
        <Button
            x:Name="uxButton1"
            Grid.Row="0"
            Grid.Column="0"
            Clicked="uxButton1_Clicked"
            HorizontalOptions="Center"
            Text="1 Item"
            VerticalOptions="Center" />

        <Button
            x:Name="uxButton2"
            Grid.Row="0"
            Grid.Column="1"
            Clicked="uxButton2_Clicked"
            HorizontalOptions="Center"
            Text="More Items"
            VerticalOptions="Center" />

        <CollectionView
            x:Name="uxCollectionView"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Margin="10"
            VerticalOptions="Fill">
            <CollectionView.ItemsLayout>
                <GridItemsLayout
                    HorizontalItemSpacing="8"
                    Orientation="Vertical"
                    Span="3"
                    VerticalItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid
                        BackgroundColor="WhiteSmoke"
                        HeightRequest="150"
                        RowDefinitions="*,Auto">
                        <Image
                            Grid.Row="0"
                            Aspect="AspectFill"
                            Source="dotnet_bot.png" />
                        <Label
                            Grid.Row="1"
                            HorizontalOptions="Center"
                            Text="Test"
                            TextColor="Black"
                            VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
